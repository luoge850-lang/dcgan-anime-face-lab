{
  "id": null,
  "uid": "dcgan-07",
  "title": "DCGAN Inference Service - 07",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "请求速率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dcgan-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(dcgan_http_requests_total[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "P99延迟",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dcgan-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(dcgan_http_request_latency_seconds_bucket[1m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "队列",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dcgan-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "dcgan_inference_queue_depth",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "GPU显存",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dcgan-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "dcgan_gpu_memory_used_bytes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "GPU SM",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dcgan-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "dcgan_gpu_sm_utilization_ratio * 100",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "RSS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dcgan-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "dcgan_process_resident_memory_bytes",
          "refId": "A"
        }
      ]
    }
  ]
}